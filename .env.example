# Copy to .env and fill in. Inspect AI loads .env automatically; never commit .env.

# OpenRouter key (one key for Claude and open models). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: call Anthropic directly instead of via OpenRouter
# ANTHROPIC_API_KEY=

# Where Inspect writes .eval logs (default ./logs)
INSPECT_LOG_DIR=./logs

# Optional default model when a config doesn't name one, e.g. openrouter/<provider>/<model>
# INSPECT_EVAL_MODEL=
